diff --git a/src/kpastro/chart.py b/src/kpastro/chart.py
index 74e9f28..4f2ed57 100644
--- a/src/kpastro/chart.py
+++ b/src/kpastro/chart.py
@@ -432,17 +432,11 @@ def render_chart(chart: Chart, dasha_depth: int = 5) -> str:
 
 def _deg_str(lon: float) -> str:
     """Format longitude as DD°MM'SS" with zero padding."""
-    lon = lon % 360.0
-    d = int(lon)
-    rem = (lon - d) * 60.0
-    m = int(rem)
-    s = round((rem - m) * 60.0)
-    if s == 60:
-        s = 0
-        m += 1
-    if m == 60:
-        m = 0
-        d = (d + 1) % 360
+    # KP Stellar TRUNCATES (floor) to whole arcseconds -- verified on two
+    # reference printouts (planets, cusps, ayanamsa).
+    total = int(((lon % 360.0) * 3600.0) + 1e-6) % 1296000
+    d, rem = divmod(total, 3600)
+    m, s = divmod(rem, 60)
     return f"{d:02d}\u00b0{m:02d}'{s:02d}\""
 
 
diff --git a/src/kpastro/ephemeris.py b/src/kpastro/ephemeris.py
index 25f229c..c6d1177 100644
--- a/src/kpastro/ephemeris.py
+++ b/src/kpastro/ephemeris.py
@@ -72,7 +72,7 @@ AYANAMSA_MODES["kp_new"] = swe.SIDM_KRISHNAMURTI_VP291
 #: arcsecond per century.  Re-verify against a second epoch before treating
 #: this as permanent.
 _AYANAMSA_OFFSETS_DEG: dict[str, float] = {
-    "kp_new": 50.7 / 3600.0,
+    "kp_new": 49.58 / 3600.0,
 }
 
 NODES: dict[str, int] = {"mean": swe.MEAN_NODE, "true": swe.TRUE_NODE}
@@ -291,7 +291,10 @@ class SwissEphemeris:
         return value - _AYANAMSA_OFFSETS_DEG.get(self.ayanamsa_mode, 0.0)
 
     def _calc(self, jd_ut: float, body: int, with_speed: bool = True):
-        flags = swe.FLG_SWIEPH | (swe.FLG_SPEED if with_speed else 0)
+        # KP Stellar's bodies follow Swiss' own sidereal path: apparent
+        # position minus the nutation-inclusive ayanamsa, i.e. mean-equinox
+        # longitude minus the *mean* ayanamsa -> FLG_NONUT + mean ayanamsa.
+        flags = swe.FLG_SWIEPH | swe.FLG_NONUT | (swe.FLG_SPEED if with_speed else 0)
         arr, retflag = swe.calc_ut(jd_ut, body, flags)[:2]
         return arr, retflag
 
